# Chép cấu hình nhà cung cấp bạn chọn vào .env BACKEND, không phải frontend.
# Điền key riêng trên máy bạn; không gửi key qua chat hoặc commit Git.
AI_PROVIDER=GEMINI
OPENAI_API_KEY=
# Model hỗ trợ Responses API mà tài khoản của bạn có quyền dùng.
OPENAI_MODEL=

# Muốn dùng Gemini: đổi AI_PROVIDER=GEMINI và điền hai dòng sau.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
