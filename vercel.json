{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run db:generate",
  "outputDirectory": "public",
  "regions": ["hkg1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "public/index.html"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
