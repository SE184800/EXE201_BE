generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  code  String @unique @db.VarChar(30)
  name  String @db.NVarChar(100)
  users User[]

  @@map("roles")
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique @db.VarChar(50)
  name            String           @db.NVarChar(100)
  // Filtered unique indexes for non-null email/phone are managed in migration
  // 202609210003_unique_registration_contacts (Prisma 6 cannot express the filter).
  email           String?          @db.VarChar(255)
  phone           String?          @db.VarChar(20)
  dateOfBirth     DateTime?        @db.Date
  passwordHash    String           @db.VarChar(255)
  isActive        Boolean          @default(true)
  suspendedUntil  DateTime?
  lockReason      String?          @db.NVarChar(500)
  roleId          Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  role            Role             @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions        AuthSession[]
  inventory       InventoryItem[]
  supplierProfile SupplierProfile?
  buyerOrders     WholesaleOrder[] @relation("buyerOrders")
  restockPlans    RestockPlan[]
  passwordResets  PasswordReset[]
  complaints      OrderComplaint[] @relation("buyerComplaints")
  receivedQuotes  SupplierQuote[]  @relation("quoteBuyer")
  subscription    Subscription?
  wallet          Wallet?
  walletTransactions         WalletTransaction[] @relation("walletTransactions")
  depositRequests           DepositRequest[]    @relation("depositRequests")
  withdrawalRequests        WithdrawalRequest[] @relation("withdrawalRequests")
  orderPayments             OrderPayment[]      @relation("orderPayments")
  receivedOrderPayments     OrderPayment[]      @relation("orderPaymentSupplier")

  @@index([roleId])
  @@map("users")
}

model InventoryItem {
  purchasePrice Int?
  sellingPrice  Int?
  id            Int             @id @default(autoincrement())
  ownerId       Int
  name          String          @db.NVarChar(100)
  unit          String          @db.NVarChar(20)
  quantity      Int             @default(0)
  lowThreshold  Int             @default(5)
  expiryDate    DateTime?       @db.Date
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  movements     StockMovement[]
  lots          InventoryLot[]

  @@unique([ownerId, name])
  @@map("inventory_items")
}

model InventoryLot {
  id            Int           @id @default(autoincrement())
  itemId        Int
  quantity      Int           @default(0)
  receivedAt    DateTime      @default(now())
  expiryDate    DateTime?     @db.Date
  purchasePrice Int?
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, expiryDate, receivedAt])
  @@map("inventory_lots")
}

model StockMovement {
  id             String        @id @default(uuid()) @db.VarChar(36)
  itemId         Int
  type           String        @db.VarChar(20)
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  // Historical sales without a known price stay null; never use today's price.
  unitSalePrice  Int?
  productName    String        @db.NVarChar(100)
  unit           String        @db.NVarChar(20)
  note           String        @db.NVarChar(250)
  createdAt      DateTime      @default(now())
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([itemId, createdAt])
  @@map("stock_movements")
}

model SupplierProfile {
  region                  String?           @db.NVarChar(100)
  taxCode                 String?           @db.VarChar(30)
  legalRepresentative     String?           @db.NVarChar(100)
  verificationDocumentUrl String?           @db.NVarChar(1000)
  verificationStatus      String            @default("DRAFT") @db.VarChar(20)
  verificationVersion     Int               @default(0)
  verificationNote        String?           @db.NVarChar(500)
  submittedAt             DateTime?
  reviewedAt              DateTime?
  reviewedBy              Int?
  deliveryFee             Decimal           @default(0) @db.Decimal(18, 2)
  bankName                String?           @db.NVarChar(100)
  bankAccountNumber       String?           @db.VarChar(34)
  bankAccountHolder       String?           @db.NVarChar(100)
  id                      Int               @id @default(autoincrement())
  userId                  Int               @unique
  businessName            String            @db.NVarChar(150)
  warehouseAddress        String            @db.NVarChar(255)
  deliveryRadiusKm        Decimal           @db.Decimal(8, 2)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  products                SupplierProduct[]
  orders                  WholesaleOrder[]
  complaints              OrderComplaint[]  @relation("supplierComplaints")
  quotes                  SupplierQuote[]

  @@map("supplier_profiles")
}

model SupplierProduct {
  category       String                        @default("Khác") @db.NVarChar(60)
  imageUrl       String?                       @db.NVarChar(1000)
  id             Int                           @id @default(autoincrement())
  supplierId     Int
  name           String                        @db.NVarChar(150)
  packaging      String                        @db.NVarChar(50)
  wholesalePrice Decimal                       @db.Decimal(18, 2)
  stockQty       Int
  moq            Int
  isActive       Boolean                       @default(true)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  supplier       SupplierProfile               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderItems     WholesaleOrderItem[]
  priceHistory   SupplierProductPriceHistory[]
  quoteLines     SupplierQuoteLine[]

  @@index([supplierId, isActive])
  @@map("supplier_products")
}

model SupplierProductPriceHistory {
  id            Int             @id @default(autoincrement())
  productId     Int
  oldPrice      Decimal         @db.Decimal(18, 2)
  newPrice      Decimal         @db.Decimal(18, 2)
  changePercent Decimal         @db.Decimal(9, 2)
  reason        String?         @db.NVarChar(500)
  changedBy     Int
  createdAt     DateTime        @default(now())
  product       SupplierProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId, createdAt])
  @@map("supplier_product_price_history")
}

model HolidayConfig {
  id               Int      @id @default(autoincrement())
  name             String   @db.NVarChar(150)
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  preparationDays  Int      @default(14)
  demandMultiplier Decimal  @default(1) @db.Decimal(4, 2)
  categoryKeywords String   @db.NVarChar(1000)
  description      String?  @db.NVarChar(500)
  isActive         Boolean  @default(true)
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, startDate, endDate])
  @@map("holiday_configs")
}

model WholesaleOrder {
  commissionRate             Decimal?             @db.Decimal(5, 2)
  commissionAmount           Decimal?             @db.Decimal(18, 2)
  deliveredAt                DateTime?
  supplierRegion             String?              @db.NVarChar(100)
  commissionPaidAt           DateTime?
  commissionPaidBy           Int?
  commissionPaymentReference String?              @db.NVarChar(150)
  requestId                  String?              @db.VarChar(36)
  requestHash                String?              @db.VarChar(64)
  recipientName              String?              @db.NVarChar(100)
  recipientPhone             String?              @db.VarChar(20)
  deliveryAddress            String?              @db.NVarChar(500)
  id                         Int                  @id @default(autoincrement())
  supplierId                 Int
  buyerId                    Int
  status                     String               @db.VarChar(30)
  subtotal                   Decimal              @db.Decimal(18, 2)
  deliveryFee                Decimal              @db.Decimal(18, 2)
  total                      Decimal              @db.Decimal(18, 2)
  note                       String?              @db.NVarChar(500)
  rejectReason               String?              @db.NVarChar(255)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  supplier                   SupplierProfile      @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  buyer                      User                 @relation("buyerOrders", fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                      WholesaleOrderItem[]
  dealStatus                 String?              @db.VarChar(20)
  proposedTotal              Decimal?             @db.Decimal(18, 2)
  agreedTotal                Decimal?             @db.Decimal(18, 2)
  dealResponse               String?              @db.NVarChar(500)
  depositRate                Decimal              @default(0) @db.Decimal(5, 2)
  depositAmount              Decimal              @default(0) @db.Decimal(18, 2)
  depositStatus              String               @default("NONE") @db.VarChar(20)
  depositReference           String?              @db.VarChar(100)
  depositBankName            String?              @db.NVarChar(100)
  depositBankAccountNumber   String?              @db.VarChar(34)
  depositBankAccountHolder   String?              @db.NVarChar(100)
  depositSubmittedAt         DateTime?
  depositPaidAt              DateTime?
  depositReviewedAt          DateTime?
  depositRejectionReason     String?              @db.NVarChar(255)
  depositRefundedAt          DateTime?
  depositRefundReference     String?              @db.VarChar(100)
  complaint                  OrderComplaint?
  sourceQuote                SupplierQuote?       @relation("quoteOrder")
  orderPayment               OrderPayment?
  refunds                    Refund[]
  walletTransactions         WalletTransaction[]

  @@index([supplierId, status])
  @@index([buyerId])
  @@index([deliveredAt])
  @@index([commissionPaidAt])
  @@map("wholesale_orders")
}

model SupplierQuote {
  id           Int                 @id @default(autoincrement())
  supplierId   Int
  buyerId      Int
  title        String              @db.NVarChar(150)
  status       String              @default("SENT") @db.VarChar(20)
  validUntil   DateTime            @db.Date
  subtotal     Decimal             @db.Decimal(18, 2)
  deliveryFee  Decimal             @default(0) @db.Decimal(18, 2)
  total        Decimal             @db.Decimal(18, 2)
  depositRate  Decimal             @default(0) @db.Decimal(5, 2)
  note         String?             @db.NVarChar(500)
  responseNote String?             @db.NVarChar(500)
  respondedAt  DateTime?
  orderId      Int?                @unique
  version      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  supplier     SupplierProfile     @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  buyer        User                @relation("quoteBuyer", fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order        WholesaleOrder?     @relation("quoteOrder", fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines        SupplierQuoteLine[]

  @@index([supplierId, status, createdAt])
  @@index([buyerId, status, createdAt])
  @@map("supplier_quotes")
}

model SupplierQuoteLine {
  id          Int             @id @default(autoincrement())
  quoteId     Int
  productId   Int
  productName String          @db.NVarChar(150)
  packaging   String          @db.NVarChar(50)
  quantity    Int
  unitPrice   Decimal         @db.Decimal(18, 2)
  lineTotal   Decimal         @db.Decimal(18, 2)
  quote       SupplierQuote   @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     SupplierProduct @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([quoteId])
  @@index([productId])
  @@map("supplier_quote_lines")
}

model Subscription {
  id                 Int                   @id @default(autoincrement())
  userId             Int                   @unique
  status             String                @default("TRIAL") @db.VarChar(20)
  monthlyPrice       Decimal               @default(19000) @db.Decimal(18, 2)
  trialStartedAt     DateTime
  trialEndsAt        DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments           SubscriptionPayment[]

  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  requestId      String       @unique @db.VarChar(36)
  amount         Decimal      @db.Decimal(18, 2)
  status         String       @default("PAID") @db.VarChar(20)
  method         String       @default("SIMULATED") @db.VarChar(30)
  reference      String       @db.VarChar(100)
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([subscriptionId, paidAt])
  @@map("subscription_payments")
}

model OrderComplaint {
  id          Int             @id @default(autoincrement())
  orderId     Int             @unique
  buyerId     Int
  supplierId  Int
  reason      String          @db.NVarChar(200)
  description String          @db.NVarChar(1000)
  imageUrl    String?         @db.NVarChar(1000)
  status      String          @default("OPEN") @db.VarChar(20)
  response    String?         @db.NVarChar(1000)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  order       WholesaleOrder  @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  buyer       User            @relation("buyerComplaints", fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier    SupplierProfile @relation("supplierComplaints", fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([buyerId, status])
  @@index([supplierId, status])
  @@map("order_complaints")
}

model WholesaleOrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String          @db.NVarChar(150)
  packaging   String          @db.NVarChar(50)
  quantity    Int
  unitPrice   Decimal         @db.Decimal(18, 2)
  lineTotal   Decimal         @db.Decimal(18, 2)
  order       WholesaleOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     SupplierProduct @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
  @@index([productId])
  @@map("wholesale_order_items")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PlatformSetting {
  id             Int      @id
  commissionRate Decimal  @default(0) @db.Decimal(5, 2)
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("platform_settings")
}

// Actor IDs are snapshots: deleting an account must not delete financial/audit history.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String   @db.VarChar(60)
  entityType String   @db.VarChar(40)
  entityId   String   @db.VarChar(50)
  details    String   @db.NVarChar(Max)
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AiUsageEvent {
  id           Int      @id @default(autoincrement())
  userId       Int
  provider     String   @db.VarChar(20)
  model        String?  @db.NVarChar(100)
  status       String   @db.VarChar(20)
  durationMs   Int
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  @@index([createdAt, provider])
  @@map("ai_usage_events")
}

model RecommendationRun {
  id          String    @id @default(uuid()) @db.VarChar(36)
  ownerId     Int
  horizonDays Int
  safetyDays  Int
  suggestions String    @db.NVarChar(Max)
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([ownerId, createdAt])
  @@map("recommendation_runs")
}

model PasswordReset {
  tokenHash        String   @id @db.VarChar(64)
  userId           Int
  passwordSnapshot String   @db.VarChar(255)
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model RestockPlan {
  id          String            @id @default(uuid()) @db.VarChar(36)
  ownerId     Int
  name        String            @db.NVarChar(100)
  note        String            @db.NVarChar(500)
  horizonDays Int
  safetyDays  Int
  requestHash String            @db.VarChar(64)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lines       RestockPlanLine[]

  @@index([ownerId, createdAt])
  @@map("restock_plans")
}

model RestockPlanLine {
  purchasePrice     Int?
  id                Int         @id @default(autoincrement())
  planId            String      @db.VarChar(36)
  sourceItemId      Int
  productName       String      @db.NVarChar(100)
  unit              String      @db.NVarChar(20)
  quantity          Int
  stockSnapshot     Int
  suggestedQuantity Int?
  averageDailySales Float?
  observedDays      Int
  plan              RestockPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([planId, sourceItemId])
  @@map("restock_plan_lines")
}

// =====================
// WALLET MANAGEMENT MODULE
// =====================

// One wallet per user. `balance` is spendable money, `heldBalance` is money
// frozen by a pending withdrawal request.
model Wallet {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  balance     Decimal  @default(0) @db.Decimal(18, 2)
  heldBalance Decimal  @default(0) @db.Decimal(18, 2)
  currency    String   @default("VND") @db.VarChar(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions  WalletTransaction[]

  @@map("wallets")
}

// Append-only ledger. Never deleted so money can always be audited.
model WalletTransaction {
  id          Int      @id @default(autoincrement())
  walletId    Int
  userId      Int
  // DEPOSIT | WITHDRAWAL_HOLD | WITHDRAWAL_RELEASE | WITHDRAWAL_PAYOUT | ORDER_PAYMENT | ORDER_RECEIVE | REFUND | REFUND_RECEIVED | ADJUSTMENT
  type        String   @db.VarChar(30)
  direction   String   @db.VarChar(10)
  amount      Decimal  @db.Decimal(18, 2)
  balanceAfter Decimal @db.Decimal(18, 2)
  reference   String   @unique @db.VarChar(100)
  status      String   @default("COMPLETED") @db.VarChar(20)
  // REAL | SANDBOX. Sandbox rows are simulated money used for demos.
  method      String   @default("REAL") @db.VarChar(20)
  orderId     Int?
  note        String?  @db.NVarChar(500)
  createdAt   DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User     @relation("walletTransactions", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order       WholesaleOrder? @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
  @@map("wallet_transactions")
}

// Manual deposit request confirmed by an administrator.
model DepositRequest {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Decimal  @db.Decimal(18, 2)
  method      String   @default("BANK_TRANSFER") @db.VarChar(30)
  // REAL | SANDBOX. Sandbox requests are simulated and settle instantly.
  isSandbox   Boolean  @default(false)
  bankName    String?  @db.NVarChar(100)
  bankAccountNumber String? @db.VarChar(34)
  bankAccountHolder String? @db.NVarChar(100)
  reference   String?  @db.VarChar(100)
  status      String   @default("PENDING") @db.VarChar(20)
  note        String?  @db.NVarChar(500)
  adminNote   String?  @db.NVarChar(500)
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("depositRequests", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@map("deposit_requests")
}

// Withdrawal request. Money is held in `Wallet.heldBalance` while pending.
model WithdrawalRequest {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Decimal  @db.Decimal(18, 2)
  // REAL | SANDBOX. Sandbox withdrawals settle instantly without review.
  isSandbox   Boolean  @default(false)
  bankName    String   @db.NVarChar(100)
  bankAccountNumber String @db.VarChar(34)
  bankAccountHolder String @db.NVarChar(100)
  note        String?  @db.NVarChar(500)
  status      String   @default("PENDING") @db.VarChar(20)
  adminNote   String?  @db.NVarChar(500)
  reference   String?  @db.VarChar(100)
  reviewedBy  Int?
  reviewedAt  DateTime?
  completedBy Int?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("withdrawalRequests", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

// Payment of a wholesale order made with the buyer wallet.
// The unique orderId guarantees an order can only be paid once.
model OrderPayment {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique
  buyerId     Int
  supplierUserId Int
  amount      Decimal  @db.Decimal(18, 2)
  commissionAmount Decimal? @db.Decimal(18, 2)
  supplierAmount Decimal? @db.Decimal(18, 2)
  status      String   @default("PAID") @db.VarChar(20)
  reference   String   @unique @db.VarChar(100)
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       WholesaleOrder @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  buyer       User     @relation("orderPayments", fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier    User     @relation("orderPaymentSupplier", fields: [supplierUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refund      Refund?

  @@index([buyerId, paidAt])
  @@index([supplierUserId, paidAt])
  @@map("order_payments")
}

// Refund of a paid order. The unique orderPaymentId prevents double refunds.
model Refund {
  id            Int      @id @default(autoincrement())
  orderId       Int
  orderPaymentId Int     @unique
  amount        Decimal  @db.Decimal(18, 2)
  reason        String   @db.NVarChar(500)
  status        String   @default("COMPLETED") @db.VarChar(20)
  reference     String   @unique @db.VarChar(100)
  createdBy     Int?
  createdAt     DateTime @default(now())
  order       WholesaleOrder @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderPayment  OrderPayment @relation(fields: [orderPaymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
  @@map("refunds")
}
