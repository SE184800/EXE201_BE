NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# SQL Server Express, TCP 1433, Windows Authentication.
# Chạy terminal bằng cùng tài khoản Windows dùng SSMS.
DATABASE_URL="sqlserver://localhost:1433;database=supplymindAI;integratedSecurity=true;encrypt=true;trustServerCertificate=true"
# SQL Authentication: thay integratedSecurity=true bằng user=...;password=...
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SEED_PASSWORD=replace-with-your-own-password
