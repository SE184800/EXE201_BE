# Windows Authentication của tài khoản đang chạy terminal
DATABASE_URL="sqlserver://localhost:1433;database=supplymindAI;integratedSecurity=true;trustServerCertificate=true"
# SQL Authentication: thay integratedSecurity=true bằng user=...;password=...
JWT_SECRET=
SEED_PASSWORD=
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Không bắt buộc. Xem AI.env.example để cấu hình Gemini/OpenAI.
# Không đặt API key trong FE.
AI_PROVIDER=OPENAI
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Khôi phục mật khẩu: local ghi thư test vào .local-mail (không gửi email).
# Production dùng smtp + cấu hình dưới đây, hoặc disabled.
MAIL_TRANSPORT=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cấu hình gửi mail OTP qua Gmail (Google App Password)
# Hướng dẫn tạo: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Tài khoản ngân hàng nhận tiền cho mã QR VietQR. Bỏ trống thì tắt tính năng nạp QR.
QR_BANK_CODE=970403
QR_BANK_NAME=Sacombank
QR_BANK_ACCOUNT=
QR_BANK_HOLDER=
